# Public site origin used for canonical URLs, sitemap and RSS.
PUBLIC_SITE_URL=https://example.com

# Google AdSense. Leave empty until the site is approved.
# When empty: dev shows dashed placeholder boxes, production renders nothing.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_LEADERBOARD=
PUBLIC_ADSENSE_SLOT_INFEED=
PUBLIC_ADSENSE_INFEED_LAYOUT_KEY=
PUBLIC_ADSENSE_SLOT_SIDEBAR=

# House ad (R-15). While AdSense is off, an https URL here fills the empty slots with
# "Advertise here" linking to it (a Google Form). Empty = slots stay empty, as before.
# _JA is used on /ja/ pages and falls back to the line above; English pages never use _JA.
PUBLIC_AD_INQUIRY_URL=https://docs.google.com/forms/d/e/1FAIpQLSfNqLiAv-8LegmQXD4nzoqRrQYXu8XFgaopClg3ciCygNo1nw/viewform
PUBLIC_AD_INQUIRY_URL_JA=https://docs.google.com/forms/d/e/1FAIpQLScKWR9mCXgzRkFmPPB_YVtli8dFLyh43xuHfP7-77CDBHfTDw/viewform

# Analytics. Vercel Web Analytics is cookie-less; enable it on the Vercel project, then set 1 here.
PUBLIC_VERCEL_ANALYTICS=
# Optional Google Analytics 4 measurement id (G-XXXXXXXXXX). Uses cookies; consent-gated in EU/UK/CH.
PUBLIC_GA_MEASUREMENT_ID=

# GitHub repository that receives project submissions (owner/repo).
PUBLIC_GITHUB_REPO=
