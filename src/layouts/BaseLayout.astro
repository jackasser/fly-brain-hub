---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdSlot from '../components/AdSlot.astro';
import { alternates, canonical, serializeJsonLd } from '../lib/seo';
import { isAdsEnabled, type AdEnv } from '../lib/ads';
import { localePath, stripLocale, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Current path; may be locale-prefixed or not. */
  path: string;
  jsonLd?: Record<string, unknown>;
  ogType?: 'website' | 'article';
  /** false on pages that must never carry ads (404). */
  ads?: boolean;
  /** false on pages with no locale twin (404). */
  alternatesEnabled?: boolean;
  /** Test overrides. */
  adEnv?: AdEnv;
  dev?: boolean;
}

const { locale, title, description, jsonLd, ogType = 'website', ads = true, alternatesEnabled = true } = Astro.props;
const bare = stripLocale(Astro.props.path);
const here = localePath(locale, bare);
const site = (Astro.site ?? new URL('https://example.com')).toString();
const canon = canonical(site, here);
const alts = alternatesEnabled ? alternates(site, bare) : [];
const ogImage = new URL('/og.png', site).toString();
const siteName = t(locale, 'site.name');
const fullTitle = title === siteName ? `${siteName} — ${t(locale, 'site.tagline')}` : `${title} · ${siteName}`;
const env: AdEnv = Astro.props.adEnv ?? (import.meta.env as unknown as AdEnv);
const adsOn = ads && isAdsEnabled(env);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canon} />
    {alts.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" type="application/rss+xml" title={siteName} href={localePath(locale, '/rss.xml')} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canon} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={locale === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
    {
      adsOn && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${env.PUBLIC_ADSENSE_CLIENT}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body>
    <Header locale={locale} path={here} />
    {
      ads && (
        <div class="container">
          <AdSlot name="leaderboard" locale={locale} env={Astro.props.adEnv} dev={Astro.props.dev} />
        </div>
      )
    }
    <main class="container" id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
