---
import ProjectDetailPage from '../../components/pages/ProjectDetailPage.astro';
import { loadProjects } from '../../lib/load';

export async function getStaticPaths() {
  const projects = await loadProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
---

<ProjectDetailPage locale="en" project={project} />
