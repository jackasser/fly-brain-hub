---
import LangToggle from './LangToggle.astro';
import { localePath, stripLocale, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const bare = stripLocale(path);
const items: {
  href: string;
  key: 'nav.projects' | 'nav.datasets' | 'nav.explainer' | 'nav.about' | 'nav.submit';
}[] = [
  { href: '/projects', key: 'nav.projects' },
  { href: '/datasets', key: 'nav.datasets' },
  { href: '/what-is-a-fly-brain', key: 'nav.explainer' },
  { href: '/about', key: 'nav.about' },
  { href: '/submit', key: 'nav.submit' },
];
const isCurrent = (href: string) => bare === href || bare.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={localePath(locale, '/')}>
      <img class="brand__mark" src="/favicon.svg" alt="" width="24" height="24" aria-hidden="true" />
      {t(locale, 'site.name')}
    </a>
    <nav class="nav" aria-label={t(locale, 'a11y.navigation')}>
      {
        items.map((item) => (
          <a href={localePath(locale, item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {t(locale, item.key)}
          </a>
        ))
      }
    </nav>
    <LangToggle locale={locale} path={path} />
  </div>
</header>
