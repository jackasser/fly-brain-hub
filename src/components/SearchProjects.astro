---
import { CATEGORIES, CATEGORY_META, DATASET_IDS, DATASET_LABELS } from '../lib/taxonomy';
import { SORT_MODES } from '../lib/sort';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** id of the ProjectGrid element whose cards get filtered */
  gridId: string;
}
const { locale, gridId } = Astro.props;
---

<form
  class="search"
  data-search
  data-grid={gridId}
  data-locale={locale}
  data-results={t(locale, 'search.results')}
  data-none={t(locale, 'search.none')}
  data-loading={t(locale, 'search.loading')}
  data-failed={t(locale, 'search.failed')}
  role="search"
>
  <div class="search__row">
    <div class="search__field search__field--query">
    <label for="search-q">{t(locale, 'search.label')}</label>
    <input id="search-q" name="q" type="search" placeholder={t(locale, 'search.placeholder')} autocomplete="off" />
    </div>
    <div class="search__field">
    <label for="search-category">{t(locale, 'search.category')}</label>
    <select id="search-category" name="category">
      <option value="">{t(locale, 'search.category')}: {t(locale, 'search.all')}</option>
      {CATEGORIES.map((c) => <option value={c}>{CATEGORY_META[c].label[locale]}</option>)}
    </select>
    </div>
    <div class="search__field">
    <label for="search-dataset">{t(locale, 'search.dataset')}</label>
    <select id="search-dataset" name="dataset">
      <option value="">{t(locale, 'search.dataset')}: {t(locale, 'search.all')}</option>
      {DATASET_IDS.map((d) => <option value={d}>{DATASET_LABELS[d]}</option>)}
    </select>
    </div>
    <div class="search__field">
    <label for="search-tag">{t(locale, 'search.tag')}</label>
    <select id="search-tag" name="tag">
      <option value="">{t(locale, 'search.tag')}: {t(locale, 'search.all')}</option>
    </select>
    </div>
    <div class="search__field">
    <label for="search-sort">{t(locale, 'search.sort')}</label>
    <select id="search-sort" name="sort">
      {SORT_MODES.map((m) => <option value={m}>{t(locale, `sort.${m}` as const)}</option>)}
    </select>
    </div>
    <button type="button" class="search__clear" data-clear>{t(locale, 'search.clear')}</button>
  </div>
  <p class="search__status" data-status aria-live="polite"></p>
</form>

<script>
  import Fuse from 'fuse.js';
  import type { SearchItem } from '../lib/projects';
  import { DEFAULT_SORT, isSortMode, sortRows, type SortRow } from '../lib/sort';

  const KEYS = ['q', 'category', 'dataset', 'tag', 'sort'] as const;
  type Key = (typeof KEYS)[number];

  async function init(form: HTMLFormElement) {
    // NOTE: a form control named "dataset" shadows form.dataset, so read attributes explicitly.
    const attr = (k: string) => form.getAttribute(`data-${k}`) ?? '';
    const maybeGrid = document.getElementById(attr('grid'));
    if (!maybeGrid) return;
    const grid = maybeGrid;
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-id]')];
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const locale = attr('locale') === 'ja' ? 'ja' : 'en';
    const controls = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLButtonElement>('input, select, button')];
    const setEnabled = (on: boolean) => controls.forEach((c) => (c.disabled = !on));

    setEnabled(false);
    status.dataset.state = 'loading';
    status.textContent = attr('loading');
    let items: SearchItem[];
    try {
      const res = await fetch('/search-index.json');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      items = (await res.json()) as SearchItem[];
      if (!Array.isArray(items)) throw new Error('bad index');
    } catch {
      // Keep the server-rendered full list; make it obvious the search box is inert.
      status.dataset.state = 'failed';
      status.textContent = attr('failed');
      return;
    }
    setEnabled(true);
    status.dataset.state = 'ready';
    const byId = new Map(items.map((i) => [i.id, i]));
    const fuse = new Fuse(items, {
      keys: [
        { name: 'name', weight: 3 },
        { name: 'tags', weight: 2 },
        { name: `description_${locale}`, weight: 1 },
      ],
      threshold: 0.35,
      ignoreLocation: true,
      minMatchCharLength: 2,
    });

    const field = (k: Key) => form.elements.namedItem(k) as HTMLInputElement | HTMLSelectElement;

    // tag options from the index, most used first
    const tagCounts = new Map<string, number>();
    for (const i of items) for (const t of i.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
    const tagSelect = field('tag') as HTMLSelectElement;
    for (const [tag, n] of [...tagCounts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))) {
      tagSelect.append(new Option(`${tag} (${n})`, tag));
    }

    // restore from URL
    const params = new URLSearchParams(location.search);
    for (const k of KEYS) {
      const v = params.get(k);
      if (!v) continue;
      if (k === 'sort' && !isSortMode(v)) continue; // ignore a bogus ?sort=
      field(k).value = v;
    }

    /**
     * R-16: reorder the cards among themselves. Non-card children of the grid (the in-feed
     * ad slots) keep their child index, so a requested ad is never moved or dropped.
     */
    let appliedSort: string | null = null;
    function reorder(mode: string) {
      // apply() runs on every keystroke; moving 70+ nodes each time would be wasteful.
      if (mode === appliedSort) return;
      appliedSort = mode;
      const rows: SortRow[] = cards.map((card) => ({
        id: card.dataset.id ?? '',
        stars: card.dataset.stars ? Number(card.dataset.stars) : undefined,
        addedAt: card.dataset.added ?? '',
      }));
      const order = sortRows(rows, isSortMode(mode) ? mode : DEFAULT_SORT);
      const byIdEl = new Map(cards.map((c) => [c.dataset.id ?? '', c]));
      let next = 0;
      const rebuilt = [...grid.children].map((el) =>
        el.hasAttribute('data-id') ? (byIdEl.get(order[next++].id) ?? el) : el,
      );
      grid.replaceChildren(...rebuilt);
    }

    function apply() {
      const q = field('q').value.trim();
      const cat = field('category').value;
      const ds = field('dataset').value;
      const tag = field('tag').value;
      const sort = field('sort').value;
      reorder(sort);
      const matched = q ? new Set(fuse.search(q).map((r) => r.item.id)) : null;
      let n = 0;
      for (const card of cards) {
        const item = byId.get(card.dataset.id ?? '');
        const ok =
          !!item &&
          (!matched || matched.has(item.id)) &&
          (!cat || item.category === cat) &&
          (!ds || item.datasets.includes(ds)) &&
          (!tag || item.tags.includes(tag));
        card.hidden = !ok;
        if (ok) n++;
      }
      status.textContent = n ? `${n} ${attr('results')}` : attr('none');
      const next = new URLSearchParams();
      if (q) next.set('q', q);
      if (cat) next.set('category', cat);
      if (ds) next.set('dataset', ds);
      if (tag) next.set('tag', tag);
      if (sort && sort !== DEFAULT_SORT) next.set('sort', sort);
      const qs = next.toString();
      history.replaceState(null, '', qs ? `${location.pathname}?${qs}` : location.pathname);
    }

    form.addEventListener('input', apply);
    form.addEventListener('change', apply);
    form.addEventListener('submit', (e) => e.preventDefault());
    form.querySelector('[data-clear]')?.addEventListener('click', () => {
      for (const k of KEYS) field(k).value = k === 'sort' ? DEFAULT_SORT : '';
      apply();
    });
    apply();
  }

  const form = document.querySelector<HTMLFormElement>('form[data-search]');
  if (form) init(form);
</script>
