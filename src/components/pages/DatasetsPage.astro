---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadProjects } from '../../lib/load';
import { byCategory, datasetUsage } from '../../lib/projects';
import { localePath, t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const all = await loadProjects();
const datasets = byCategory(all, 'connectome').sort((a, b) => (a.date < b.date ? 1 : -1));
const usage = datasetUsage(all);
---

<BaseLayout locale={locale} title={t(locale, 'datasets.title')} description={t(locale, 'datasets.intro')} path="/datasets">
  <section class="section">
    <h1>{t(locale, 'datasets.title')}</h1>
    <p class="prose">{t(locale, 'datasets.intro')}</p>
    <div class="table-wrap">
      <table class="datasets">
        <thead>
          <tr>
            <th>{t(locale, 'nav.datasets')}</th>
            <th>{t(locale, 'project.org')}</th>
            <th>{t(locale, 'project.date')}</th>
            <th>{t(locale, 'project.license')}</th>
            <th>{t(locale, 'datasets.usedBy')}</th>
          </tr>
        </thead>
        <tbody>
          {
            datasets.map((d) => (
              <tr>
                <td>
                  <a href={localePath(locale, `/projects/${d.id}`)}>
                    <strong>{d.name}</strong>
                  </a>
                </td>
                <td>{d.org}</td>
                <td class="nowrap">{d.date}</td>
                <td class="nowrap">{d.license ?? '—'}</td>
                <td class="nowrap num" data-dataset={d.id} data-used-by={usage.get(d.id) ?? 0}>
                  {usage.get(d.id) ?? 0} {t(locale, 'datasets.projects')}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
