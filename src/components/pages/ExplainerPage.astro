---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Callout from '../Callout.astro';
import GuideVisual from '../GuideVisual.astro';
import GuideJourney from '../GuideJourney.astro';
import GuidePatterns from '../GuidePatterns.astro';
import { localePath, t, type Locale } from '../../i18n';
import { guideGroups, guideProjects } from '../../data/explainer';
interface Props { locale: Locale }
const { locale } = Astro.props;
const ja = locale === 'ja';
const title = t(locale, 'explainer.title');
const p = (id: string) => localePath(locale, '/projects/' + id);
const fields = [
  ['features', ja ? '主な機能' : 'Features'],
  ['io', ja ? '入力 → 出力' : 'Input → output'],
  ['needs', ja ? '必要なもの' : 'What you need'],
  ['start', ja ? '最初に試すこと' : 'First step'],
  ['limits', ja ? 'わかる範囲・限界' : 'Scope and limits'],
] as const;
---
<BaseLayout locale={locale} title={title} description={t(locale, 'explainer.description')} path="/what-is-a-fly-brain">
  <article class="section explainer guide">
    <header class="guide-hero">
      <p class="guide-eyebrow">{ja ? 'はじめてのハエ脳ガイド' : 'A practical guide to fly brains'}</p>
      <h1>{title}</h1>
      <p class="guide-lead">{ja
        ? '配線を見る。刺激する。身体を動かす。ゲームで試す。やりたいことを選んで、図と手順で始めましょう。'
        : 'Explore wiring. Stimulate neurons. Control a body. Try a game. Pick a goal and follow the visual steps.'}</p>
      <div class="guide-reading-path" aria-label={ja ? 'このページの読み方' : 'How to use this guide'}>
        <span>{ja ? '目的を選ぶ' : 'Pick a goal'}</span><b aria-hidden="true">→</b>
        <span>{ja ? '図でつかむ' : 'See how it works'}</span><b aria-hidden="true">→</b>
        <span>{ja ? '3 ステップで試す' : 'Follow 3 steps'}</span>
      </div>
      <nav class="guide-topics" aria-label={ja ? '構成と学習の解説' : 'Architecture and training explainers'}>
        <a href="#simulation-patterns">{ja ? '脳と身体の構成を比較' : 'Compare brain and body setups'} ↓</a>
        <a href="#learning-patterns">{ja ? 'どこを学習させる？' : 'Which part learns?'} ↓</a>
      </nav>
    </header>

    <section aria-labelledby="overview-title">
      <h2 id="overview-title">{ja ? 'まず、何をしてみたいですか？' : 'What would you like to try?'}</h2>
      <nav class="guide-overview" data-guide-overview aria-label={ja ? '目的から解説へ' : 'Explore by purpose'}>
        {guideGroups.map((group, i) => <a href={'#guide-' + group.id}>
          <GuideVisual kind={group.id} locale={locale} />
          <span class="guide-number" aria-hidden="true">0{i + 1}</span>
          <strong>{group[locale].title}</strong>
          <span>{group[locale].summary}</span>
          <small>{group[locale].level}</small>
          <span class="guide-card-action">{ja ? '図解と始め方を見る' : 'See the steps'} <span aria-hidden="true">↓</span></span>
        </a>)}
      </nav>
      <p class="guide-overview-note">{ja ? '図は仕組みを表す模式図です。迷ったら「見る・調べる」から。' : 'Illustrations are schematics. Start with wiring exploration if you are unsure.'}</p>
    </section>

    <section class="guide-foundation" aria-labelledby="foundation-title">
      <div>
        <p class="guide-eyebrow">{ja ? '仕組みをつかむ' : 'How it works'}</p>
        <h2 id="foundation-title">{ja ? '配線図に、動くためのルールを足す' : 'Wiring needs rules to become a model'}</h2>
        <p>{ja ? '神経細胞（ニューロン）どうしのつながりを記録したものが「コネクトーム」です。シナプスは細胞間で信号を伝える接点。配線図は、そのつながりを示します。' : 'A connectome records connections between nerve cells, or neurons. Synapses are the contact points through which cells transmit signals.'}</p>
        <p>{ja ? '活動を計算するには、信号の強さや発火の条件も必要です。さらに身体やゲームを動かすなら、何を入力し、活動をどの操作に変えるかを設計します。' : 'Simulating activity also requires signal strengths and firing rules. Controlling a body or game adds another design choice: how inputs and neural activity map to actions.'}</p>
        <p>{ja ? '掲載データの例：' : 'Listed data examples: '}
          <a href={p('flywire-fafb')}>FlyWire</a> / <a href={p('malecns')}>MaleCNS</a>
        </p>
      </div>
    <figure class="fly-diagram">
      <svg viewBox="0 0 360 250" role="img" aria-labelledby="diagram-title">
        <title id="diagram-title">
          {
            ja
              ? '測った配線図と、人が決めたダイナミクスのモデルを足すと、動く「ハエの脳」になる'
              : 'A measured wiring diagram plus a chosen dynamical model makes a running fly brain'
          }
        </title>
        <g class="fly-diagram__box fly-diagram__box--measured">
          <rect x="10" y="8" width="340" height="62" rx="10" />
          <text x="26" y="32" class="fly-diagram__tag">{ja ? '測った' : 'MEASURED'}</text>
          <text x="26" y="55" class="fly-diagram__label">
            {ja ? '配線図 — どれがどれに、何本' : 'Wiring — which neuron, to which, how many'}
          </text>
        </g>
        <text x="180" y="96" class="fly-diagram__op">+</text>
        <g class="fly-diagram__box fly-diagram__box--chosen">
          <rect x="10" y="108" width="340" height="62" rx="10" />
          <text x="26" y="132" class="fly-diagram__tag">{ja ? '決めた' : 'CHOSEN'}</text>
          <text x="26" y="155" class="fly-diagram__label">
            {ja ? '信号を伝える強さ・発火の条件' : 'Signal strengths and firing rules'}
          </text>
        </g>
        <text x="180" y="196" class="fly-diagram__op">=</text>
        <g class="fly-diagram__box fly-diagram__box--result">
          <rect x="10" y="206" width="340" height="38" rx="10" />
          <text x="180" y="231" class="fly-diagram__result">
            {ja ? '動く「ハエの脳」' : 'A running "fly brain"'}
          </text>
        </g>
      </svg>
      <figcaption>
        {
          ja
            ? '動いているのは、測った配線と、人が選んだモデルの組み合わせ。'
            : 'What runs is measured wiring plus a model somebody chose.'
        }
      </figcaption>
    </figure>
    </section>

    <GuidePatterns locale={locale} />

    <section aria-labelledby="repositories-title">
      <h2 id="repositories-title">{ja ? 'できることから、最初の一歩へ' : 'From an idea to your first experiment'}</h2>
      <p>{ja ? 'それぞれの入口になるツールを一つ選び、最初に試すところまで案内します。' : 'Each route starts with one tool and walks you through an initial experiment.'}</p>
      {guideGroups.map((group, i) => <section class="guide-group" id={'guide-' + group.id} aria-labelledby={'title-' + group.id}>
        <h3 id={'title-' + group.id}><span class="guide-section-number" aria-hidden="true">0{i + 1}</span>{group[locale].title}</h3>
        <GuideJourney kind={group.id} locale={locale} />
        <p class="guide-more-label">{ja ? 'この用途のツール・機能を詳しく' : 'More about the tools for this route'}</p>
        <div class="guide-projects">
          {guideProjects.filter(project => project.group === group.id).map(project => <section class="guide-project" data-guide-project={project.id}>
            <h4><a href={p(project.id)}>{project.name}</a></h4>
            <p>{project[locale].summary}</p>
            <details>
              <summary>{ja ? '機能・試し方・限界を読む' : 'Features, first steps and limits'}</summary>
              <dl>{fields.map(([field, label]) => <div data-guide-field={field}>
                <dt>{label}</dt><dd>{project[locale][field]}</dd>
              </div>)}</dl>
              <p class="guide-checked">{ja ? '一次資料の確認日：' : 'Sources checked: '}<time datetime={project.checkedAt}>{project.checkedAt}</time></p>
            </details>
          </section>)}
        </div>
      </section>)}
    </section>

    <section aria-labelledby="limits-title">
      <h2 id="limits-title">{ja ? '結果を読むときのポイント' : 'How to interpret the results'}</h2>
      <div class="compare">
        <section>
          <h3 class="compare__head compare__head--can">{ja ? '実際に試せること' : 'What you can test'}</h3>
          <ul>
            <li><strong>{ja ? '回路の変化を比べる' : 'Compare circuit responses'}</strong><span>{ja ? '刺激や抑制の条件を変え、モデルの出力を調べる。' : 'Change stimulation or silencing and inspect model output.'}</span></li>
            <li><strong>{ja ? '動作や学習を実験する' : 'Experiment with control and training'}</strong><span>{ja ? '視覚モデルの訓練や身体制御など、実装ごとの課題を試す。' : 'Try the tasks each implementation supports, such as visual-model training or body control.'}</span></li>
          </ul>
        </section>
        <section>
          <h3 class="compare__head compare__head--cannot">{ja ? '結果だけでは言えないこと' : 'What results alone do not establish'}</h3>
          <ul>
            <li><strong>{ja ? '全てのモデルが自ら学習する' : 'Every model learns on its own'}</strong><span>{ja ? '固定配線のデモも、学習を組み合わせたモデルもある。訓練する部分を確認する。' : 'Fixed-network demos and trained models coexist. Check which parts are trained.'}</span></li>
            <li><strong>{ja ? '生きたハエを丸ごと再現した' : 'A complete living fly has been reproduced'}</strong><span>{ja ? 'ゲームの成績や身体の動作だけでは、実際の神経活動との一致は示せない。' : 'Game scores or body motion alone do not establish agreement with real neural activity.'}</span></li>
          </ul>
        </section>
      </div>
      <Callout tone="notice">{ja ? '数値は「何を数えたか」まで確認しましょう。細胞の数、細胞ペア間の結合の数、シナプスの総数は別の量です。同じデータセット名でも、版や抽出範囲が違うと数値は変わります。' : 'Check what a number counts: cells, connected cell pairs and total synapses are different quantities. Release and filtering choices can change counts within the same dataset.'}</Callout>
    </section>

    <footer class="guide-footer">
      <h2>{ja ? '次に進む' : 'Where to go next'}</h2>
      <p>{ja ? '見るだけなら FlyWire Codex、Python で回路を試すなら Shiu モデルの教材が入口になります。ほかの用途も含めて探すには、一覧をご覧ください。' : 'For visual exploration, start with FlyWire Codex. For circuit experiments in Python, try the Shiu model tutorial. Browse the directory for more uses.'}</p>
      <a class="btn" href={localePath(locale, '/projects')}>{ja ? '掲載プロジェクトを探す' : 'Browse all projects'}</a>
      <p>{ja ? '掲載の基準：一次資料で確認できた内容を、自分たちの言葉で説明しています。データの再配布は行いません。' : 'Editorial policy: we describe what primary sources support in our own words and do not redistribute datasets.'} <a href={localePath(locale, '/about')}>{ja ? '編集方針' : 'Editorial policy'}</a> / <a href={localePath(locale, '/submit')}>{ja ? '掲載を依頼する' : 'Submit a project'}</a></p>
    </footer>
  </article>
</BaseLayout>

<style>
  .guide { max-width: 68rem; margin-inline: auto; }
  .guide-hero { max-width: 54rem; padding-block: 1rem 2rem; }
  .guide h1 { max-width: 100%; text-wrap: balance; }
  .guide p { line-height: 1.85; }
  .guide-eyebrow { color: var(--accent); font-weight: 700; font-size: 0.85rem; margin-bottom: 0.65rem; }
  .guide-lead { font-size: 1.2rem; margin-top: 1.5rem; }
  .guide-reading-path { display: flex; flex-wrap: wrap; align-items: center; gap: 0.65rem; margin-top: 1.5rem; font-size: 0.85rem; color: var(--accent); }
  .guide-reading-path > span { padding: 0.4rem 0.7rem; border: 1px solid var(--line); border-radius: 6px; background: var(--bg-elev); }
  .guide-topics { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-top: 1rem; }
  .guide-topics a { display: inline-flex; align-items: center; min-height: 44px; font-size: 0.85rem; }
  .guide-overview { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin-block: 1.5rem 0.7rem; }
  .guide-overview a { display: flex; flex-direction: column; gap: 0.65rem; padding: 1.2rem; background: var(--bg-elev); border: 1px solid var(--line); border-radius: var(--radius-m); color: var(--fg); text-decoration: none; }
  .guide-overview a:hover { border-color: var(--accent); }
  .guide-number { color: var(--accent); font-family: var(--font-mono); }
  .guide-overview strong { font-size: 1.1rem; }
  .guide-overview small { color: var(--fg-muted); margin-top: auto; }
  .guide-card-action { color: var(--accent); font-weight: 650; font-size: 0.8rem; border-top: 1px solid var(--line); padding-top: 0.65rem; margin-top: 0.3rem; }
  .guide-overview-note { font-size: 0.8rem; color: var(--fg-muted); margin-bottom: 3rem; }
  .guide-foundation { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: center; padding: 2rem; border-radius: var(--radius-l); background: var(--bg-sunk); }
  .guide-foundation h2 { margin-top: 0; }
  .guide-foundation p { margin-block: 1rem; }
  .guide-group { scroll-margin-top: 8rem; margin-block: 3rem; }
  .guide-group > h3 { display: flex; gap: 0.8rem; align-items: center; font-size: 1.5rem; margin-bottom: 1rem; }
  .guide-section-number { font: 500 1rem var(--font-mono); color: var(--accent); border: 1px solid var(--line); padding: 0.5rem; border-radius: 8px; }
  .guide-more-label { font-size: 0.8rem; font-weight: 700; color: var(--fg-muted); margin-top: 1.3rem; }
  .guide-projects { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; align-items: start; }
  .guide-project { padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius-m); background: var(--bg-elev); min-width: 0; }
  .guide-project h4 { font-size: 1.15rem; margin: 0; }
  .guide-project > p { margin-block: 1rem; }
  .guide-project summary { cursor: pointer; padding-block: 0.85rem; min-height: 44px; color: var(--accent); font-weight: 600; }
  .guide-project details { border-top: 1px solid var(--line); }
  .guide-project dl { margin: 0; }
  .guide-project dl > div { margin-top: 1rem; }
  .guide-project dt { font-weight: 700; font-size: 0.9rem; }
  .guide-project dd { margin: 0.35rem 0 0; line-height: 1.8; }
  .guide-checked { color: var(--fg-muted); font-size: 0.8rem; margin-top: 1.5rem; }
  .guide-footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .guide-footer p { margin-block: 1.2rem; }
  @media (max-width: 900px) { .guide-overview { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .guide-foundation, .guide-projects { grid-template-columns: 1fr; }
    .guide-foundation { padding: 1.2rem; gap: 0; }
    .guide-project { padding: 1.2rem; }
    .guide-overview { gap: 0.65rem; }
    .guide-overview a { padding: 0.9rem; }
    .guide-overview strong { font-size: 1rem; }
    .guide-group { scroll-margin-top: 1rem; }
  }
  @media (max-width: 360px) { .guide-overview { grid-template-columns: 1fr; } }
</style>
