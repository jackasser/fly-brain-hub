---
import type { Project } from '../lib/schema';
import { coverFor, generatedCoverPath } from '../lib/media';

interface Props {
  project: Project;
  class?: string;
  /** Use eager loading for above-the-fold covers (detail page). */
  eager?: boolean;
}

const { project, class: extra = 'card__cover', eager = false } = Astro.props;
const cover = coverFor(project);
const fallback = generatedCoverPath(project.id);
const external = cover.kind !== 'generated';
---

<div class={extra} data-cover={cover.kind}>
  <img
    src={cover.src}
    alt={project.name}
    width="1200"
    height="600"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    referrerpolicy={external ? 'no-referrer' : undefined}
    onerror={external ? `this.onerror=null;this.src='${fallback}';this.removeAttribute('referrerpolicy')` : undefined}
  />
  {'credit' in cover && cover.credit && <span class="cover__credit">{cover.credit}</span>}
</div>
