---
import FlyHero from './FlyHero.astro';
import { t, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<div class="fly-scroll" data-fly-stage>
  <div class="fly-scroll__view" role="img" aria-label={t(locale, 'home.flyModelLabel')}>
    <div class="fly-scroll__fallback"><FlyHero locale={locale} /></div>
    <canvas aria-hidden="true"></canvas>
  </div>
  <p class="fly-scroll__note">{t(locale, 'home.flyScroll')}<br />
    <span>{t(locale, 'home.flyModelNote')}</span>
  </p>
</div>
<script>
  const stage = document.querySelector<HTMLElement>('[data-fly-stage]');
  if (stage) {
    const observer = new IntersectionObserver(async ([entry]) => {
      if (!entry.isIntersecting) return;
      observer.disconnect();
      try {
        const { mountFly } = await import('../lib/fly-scene');
        mountFly(stage);
      } catch { /* Keep the server-rendered illustration when 3D is unavailable. */ }
    }, { rootMargin: '120px' });
    observer.observe(stage);
  }
</script>
<style>
  .fly-scroll { width: 100%; position: relative; z-index: 1; }
  .fly-scroll__view { position: relative; width: 100%; aspect-ratio: 1.12; }
  .fly-scroll__fallback { position: absolute; inset: 0; display: grid; place-items: center; }
  .fly-scroll__fallback :global(svg) { max-height: 100%; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; pointer-events: none; }
  [data-ready] canvas { opacity: 1; }
  [data-ready] .fly-scroll__fallback { visibility: hidden; }
  .fly-scroll__note { text-align: center; font-size: 0.8rem; line-height: 1.7; color: var(--fg-muted); margin: 0.5rem 0 0; }
  .fly-scroll__note span { font-size: 0.65rem; }
  @media (max-width: 639px) { .fly-scroll__view { max-width: 19rem; margin-inline: auto; } }
</style>
